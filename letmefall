            </div>
        </main>

        <!-- Social Icons Footer -->
        <footer class="mt-auto pt-8 flex flex-col items-center space-y-6 reveal" style="transition-delay: 0.4s;">
            <div class="flex space-x-8 text-xl text-gray-500">
                <a href="https://t.me/PSIXOmaniya_music" target="_blank" class="hover:text-neonPurple transition-colors"><i class="fa-brands fa-telegram"></i></a>
                <a href="https://vk.ru/psixomaniya" target="_blank" class="hover:text-neonPurple transition-colors"><i class="fa-brands fa-vk"></i></a>
                <a href="https://youtube.com/@PSIXOmaniya" target="_blank" class="hover:text-neonPurple transition-colors"><i class="fa-brands fa-youtube"></i></a>
            </div>
            <p class="text-[10px] text-gray-700 font-bold tracking-widest uppercase">© 2026 PSIXOmaniya</p>
        </footer>
    </div>

    <script>
        // Появление сайта при загрузке
        window.addEventListener('DOMContentLoaded', () => {
            document.body.classList.add('loaded');
            
            // Запуск анимации элементов
            setTimeout(() => {
                document.querySelectorAll('.reveal').forEach(el => {
                    el.classList.add('active');
                });
            }, 300);
        });

        // Анимация названия вкладки (Typewriter)
        const titleText = "PSIXOmaniya";
        let currentIndex = 0;
        let isDeleting = false;
        let typingSpeed = 200;

        function animateTitle() {
            if (!isDeleting) {
                document.title = titleText.substring(0, currentIndex + 1);
                currentIndex++;
                typingSpeed = 200;
                if (currentIndex === titleText.length) {
                    isDeleting = true;
                    typingSpeed = 2000;
                }
            } else {
                document.title = titleText.substring(0, currentIndex - 1) || "P";
                currentIndex--;
                typingSpeed = 60;
                if (currentIndex <= 1) {
                    isDeleting = false;
                    typingSpeed = 500;
                }
            }
            setTimeout(animateTitle, typingSpeed);
        }
        animateTitle();
    </script>
</body>
</html>
