<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>P</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        darkBg: '#05030a',
                        darkCard: '#0c081a',
                        neonPurple: '#9d4edd',
                        neonViolet: '#7b2cbf',
                        neonPink: '#ff007f',
                    },
                    fontFamily: {
                        sans: ['Montserrat', 'sans-serif'],
                        syne: ['Syne', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style>
        /* Плавное появление всего сайта */
        body { 
            background-color: #05030a; 
            color: #f3f4f6; 
            overflow-x: hidden;
            opacity: 0;
            transition: opacity 1.2s ease-in-out;
        }
        body.loaded { opacity: 1; }

        /* Эффект шума/зернистости (Film Grain) */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("https://upload.wikimedia.org/wikipedia/commons/7/76/1k_Noise_Texture.png");
            opacity: 0.03;
            pointer-events: none;
            z-index: 50;
        }

        .glow-sphere { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.2; z-index: 0; pointer-events: none; }
        
        /* Glassmorphism для карточек платформ */
        .platform-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(157, 78, 221, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .platform-card:hover {
            background: rgba(157, 78, 221, 0.1);
            border-color: rgba(157, 78, 221, 0.5);
            transform: translateX(8px);
        }

        .yandex-svg { width: 24px; height: 24px; fill: currentColor; }
        
        /* Анимация обложки */
        .cover-art {
            box-shadow: 0 0 40px rgba(157, 78, 221, 0.2);
            transition: transform 0.5s ease;
        }
        .cover-art:hover { transform: scale(1.02); }

        .reveal { opacity: 0; transform: translateY(20px); transition: all 0.8s ease-out; }
        .reveal.active { opacity: 1; transform: translateY(0); }
    </style>
</head>
<body class="font-sans antialiased selection:bg-neonPurple">

    <!-- Background Decoration -->
    <div class="fixed top-[-10%] left-[-10%] w-[60vw] h-[60vw] glow-sphere bg-neonPurple"></div>
    <div class="fixed bottom-[-10%] right-[-10%] w-[60vw] h-[60vw] glow-sphere bg-neonViolet"></div>

    <div class="relative z-10 min-h-screen flex flex-col items-center py-12 px-6">
        
        <!-- Header / Logo -->
        <header class="mb-12 reveal">
            <a href="/" class="font-syne text-2xl font-extrabold tracking-[0.3em] text-neonPurple uppercase">
                PSIXOmaniya
