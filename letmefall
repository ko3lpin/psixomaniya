        </header>

        <!-- Main Release Content -->
        <main class="w-full max-w-md">
            
            <!-- Cover Art Section -->
            <div class="mb-8 reveal" style="transition-delay: 0.1s;">
                <div class="aspect-square w-full relative group">
                    <div class="absolute -inset-2 bg-neonPurple/20 blur-xl opacity-0 group-hover:opacity-100 transition duration-700"></div>
                    <img 
                        src="LETMEFALL.jpg" 
                        alt="LETMEFALL" 
                        class="cover-art relative rounded-lg w-full h-full object-cover border border-white/10"
                    >
                </div>
            </div>

            <!-- Title & Artist -->
            <div class="text-center mb-10 reveal" style="transition-delay: 0.2s;">
                <h1 class="font-syne text-4xl font-black tracking-tighter text-white mb-2 uppercase">LETMEFALL</h1>
                <p class="text-neonPurple font-bold tracking-widest text-sm uppercase">PSIXOmaniya</p>
            </div>

            <!-- Platform Links (The "Bandlink" Core) -->
            <div class="space-y-3 mb-16 reveal" style="transition-delay: 0.3s;">
                
                <!-- Spotify -->
                <a href="https://open.spotify.com/album/5WOwYTkODEZp3tNT1kMfaB?si=Ks5vW6QiQ7CHWWxbAcKM4g" target="_blank" class="platform-card flex items-center justify-between p-4 rounded-xl group">
                    <div class="flex items-center space-x-4">
                        <i class="fa-brands fa-spotify text-2xl text-[#1DB954]"></i>
                        <span class="text-sm font-bold tracking-wide uppercase">Spotify</span>
                    </div>
                    <div class="text-[10px] font-black bg-white/5 px-3 py-1 rounded-full group-hover:bg-neonPurple group-hover:text-white transition-colors uppercase">Listen</div>
                </a>

                <!-- Yandex Music -->
                <a href="https://music.yandex.ru/album/41586953" target="_blank" class="platform-card flex items-center justify-between p-4 rounded-xl group">
                    <div class="flex items-center space-x-4">
                        <svg class="yandex-svg text-white" viewBox="0 0 640 640" xmlns="http://www.w3.org/2000/svg">
                            <path d="M345.1 379.8L257.7 576L194 576L290 366.2C244.9 343.3 214.8 301.8 214.8 225.1C214.7 117.7 282.8 64 363.7 64L446 64L446 576L390.9 576L390.9 379.8L345.1 379.8zM390.9 110.5L361.5 110.5C317.1 110.5 274.1 139.9 274.1 225.1C274.1 307.4 313.5 333.9 361.5 333.9L390.9 333.9L390.9 110.5z"/>
                        </svg>
                        <span class="text-sm font-bold tracking-wide uppercase">Yandex Music</span>
                    </div>
                    <div class="text-[10px] font-black bg-white/5 px-3 py-1 rounded-full group-hover:bg-neonPurple group-hover:text-white transition-colors uppercase">Listen</div>
                </a>

                <!-- VK Music -->
                <a href="https://vk.ru/music/album/-2000377746_27377746" target="_blank" class="platform-card flex items-center justify-between p-4 rounded-xl group">
                    <div class="flex items-center space-x-4">
                        <i class="fa-brands fa-vk text-2xl text-[#0077FF]"></i>
                        <span class="text-sm font-bold tracking-wide uppercase">VK Music</span>
                    </div>
                    <div class="text-[10px] font-black bg-white/5 px-3 py-1 rounded-full group-hover:bg-neonPurple group-hover:text-white transition-colors uppercase">Listen</div>
                </a>

                <!-- Apple Music -->
                <a href="https://music.apple.com/ru/album/letmefall-single/1893092359" target="_blank" class="platform-card flex items-center justify-between p-4 rounded-xl group">
                    <div class="flex items-center space-x-4">
                        <i class="fa-brands fa-apple text-2xl text-white"></i>
                        <span class="text-sm font-bold tracking-wide uppercase">Apple Music</span>
                    </div>
                    <div class="text-[10px] font-black bg-white/5 px-3 py-1 rounded-full group-hover:bg-neonPurple group-hover:text-white transition-colors uppercase">Listen</div>
                </a>

                <!-- YouTube Music -->
                <a href="https://music.youtube.com/playlist?list=OLAK5uy_nQOUK3NzMr16X4lfnDvPftvugWQK10Zh8" target="_blank" class="platform-card flex items-center justify-between p-4 rounded-xl group">
                    <div class="flex items-center space-x-4">
                        <i class="fa-brands fa-youtube text-2xl text-[#FF0000]"></i>
                        <span class="text-sm font-bold tracking-wide uppercase">YouTube</span>
                    </div>
                    <div class="text-[10px] font-black bg-white/5 px-3 py-1 rounded-full group-hover:bg-neonPurple group-hover:text-white transition-colors uppercase">Play</div>
